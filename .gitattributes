# Normalize line endings: store text as LF in the repo, check out native on each OS
* text=auto eol=lf

# Treat binary assets as binary (never line-ending normalized)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.mov  binary
*.woff binary
*.woff2 binary
